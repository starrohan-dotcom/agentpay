{
  "name": "@starrohan/agentpay",
  "version": "1.5.0",
  "mcpName": "io.github.starrohan-dotcom/agentpay",
  "description": "Autonomous agent wallets with built-in spending policies for Ethereum",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "agentpay": "bin/agentpay.js"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/mcp/web-server.js",
    "prepublishOnly": "npm run build",
    "example": "tsx example.ts",
    "mcp": "tsx src/mcp/server.ts",
    "test": "vitest run --config vitest.config.ts",
    "lint": "eslint \"src/**/*.ts\" \"examples/**/*.ts\" \"tests/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"examples/**/*.ts\" \"tests/**/*.ts\" \"*.{js,ts,json,md,yaml}\""
  },
  "keywords": [
    "ethereum",
    "agent",
    "wallet",
    "autonomous",
    "spending",
    "policy",
    "viem",
    "base",
    "web3",
    "crypto",
    "mcp",
    "mcp-server",
    "claude",
    "autonomous-agents"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/starrohan-dotcom/agentpay.git"
  },
  "peerDependencies": {
    "viem": "^2.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.2",
    "@types/winston": "^2.4.4",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "^3.8.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2",
    "viem": "2.44.4",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@langchain/core": "^1.1.45",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "permissionless": "^0.3.5",
    "pino-pretty": "^13.1.3",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  }
}